# Color Match Studio API — deployment environment template.
# Copy into the platform's secret/env store; never commit real values.

# Required: bearer token for /v1/*. >=32 chars, >=8 distinct characters.
COLOR_API_KEY=

# Required when COLOR_DB_BACKEND=postgres.
# Dedicated application database and role; do not point this at another app.
DATABASE_URL=postgresql://color_calibration_app:REPLACE_ME@db-host:5432/color_calibration

# postgres (default when DATABASE_URL is set) or sqlite (local development only).
COLOR_DB_BACKEND=postgres

# Schema holding profiles/revisions. Use a dedicated schema when the database is
# not exclusively owned by this API.
COLOR_PG_SCHEMA=public

# verify (default) refuses to serve unless the checked-in migration is applied.
# apply runs the checked-in migrations transactionally at boot; prefer running
# `npm run db:migrate` as a separate controlled step.
COLOR_DB_MIGRATE=verify

# TLS. disable | require (encrypted, unverified) | verify-full (CA verified).
# verify-full is recommended in production.
COLOR_PG_SSL=verify-full
# PEM text, or a path to a mounted certificate file.
COLOR_PG_SSL_CA=/run/secrets/color-pg-ca.pem
# Only needed when connecting to an IP whose server certificate carries a DNS
# SAN (the certificate identity is still checked against this name).
COLOR_PG_SSL_SERVERNAME=

# Connection pool.
COLOR_PG_POOL_MAX=5
COLOR_PG_CONNECT_TIMEOUT_MS=10000
COLOR_PG_IDLE_TIMEOUT_MS=30000
# COLOR_PG_STATEMENT_TIMEOUT_MS=15000
COLOR_PG_APP_NAME=color-match-studio-api

# HTTP listener. Loopback by default; containers must opt into 0.0.0.0.
COLOR_API_HOST=0.0.0.0
PORT=8081

# Exact browser origin allowed to call the API (no wildcard).
COLOR_API_ALLOWED_ORIGIN=

# Local development only: allow the SQLite store under NODE_ENV=production.
# COLOR_DB_ALLOW_SQLITE=0
# COLOR_DB_PATH=~/.local/state/color-match-studio/calibrations.sqlite
